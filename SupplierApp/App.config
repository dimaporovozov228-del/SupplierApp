<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="SupplierDb" providerName="System.Data.OleDb"
         connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=|DataDirectory|\SupplierApp.mdb;Persist Security Info=False;Mode=Share Deny None;" />
  </connectionStrings>
</configuration>
